# Скопируйте этот файл в .env и заполните. Файл .env в git не попадает.
BOT_TOKEN=сюда_токен_бота

# Адрес API MAX (старый platform-api.max.ru больше не используется)
MAX_API_BASE=https://platform-api2.max.ru

# База SQLite. Без строки — ./aktiv.db; в Docker-образе — /app/data/aktiv.db (не задавайте здесь)
# DATABASE_URL=sqlite+aiosqlite:///./aktiv.db

# MAX user_id администраторов через запятую (свой id покажет команда /id)
ADMIN_IDS=

# Если соединение с MAX падает из-за сертификата: путь к файлу сертификатов
# (системные + корневой сертификат Минцифры). Пусто = системные по умолчанию.
# В Docker-образе по умолчанию certs/ca-bundle.pem.
# CA_BUNDLE=

# Веб-версия (app/web): порт и внешний адрес с https:// (для кнопки «🌐 Веб-версия» и мини-приложения).
# WEB_PORT=0 или без строки — выключена. В Docker-образе по умолчанию WEB_PORT=8080.
# WEB_PORT=8080
# WEB_URL=https://example.ru
